  "screening_periods": ["BOY", "MOY", "EOY"],
  
  "input_mapping": {
    "required_fields": [
      "student_id",
      "student_name",
      "grade",
      "assessment_date",
      "screening_period",
      "teacher_name",
      "school_name",
      "district_name"
    ],
    "date_format": "%Y-%m-%d",
    "merge_key": "student_id"
  },
  
  "calculation_rules": {
    "composite_calculation": {
      "method": "weighted_average",
      "description": "Calculate composite score from individual metric scores"
    },
    "percentile_rank": {
      "enabled": true,
      "description": "Calculate student's percentile rank within grade level"
    }
  },
  
  "pdf_layout": {
    "page_size": "LETTER",
    "margins": {
      "top": 0.75,
      "bottom": 0.75,
      "left": 0.75,
      "right": 0.75
    },
    "fonts": {
      "title": {"family": "Helvetica-Bold", "size": 16},
      "heading": {"family": "Helvetica-Bold", "size": 12},
      "body": {"family": "Helvetica", "size": 10},
      "small": {"family": "Helvetica", "size": 8}
    },
    "colors": {
      "high_risk": "#D32F2F",
      "some_risk": "#F57C00",
      "low_risk": "#388E3C",
      "header_bg": "#1976D2",
      "alt_row": "#F5F5F5"
    }
  },
  
  "understanding_page": {
    "title": "Understanding This Report",
    "sections": [
      {
        "heading": "Purpose",
        "content": "This Universal Screening Report provides a comprehensive snapshot of student performance at key points during the school year (Beginning, Middle, and End of Year). It identifies students who may need additional support or enrichment."
      },
      {
        "heading": "Composite Scores",
        "content": "The composite score combines multiple assessment measures to provide an overall indicator of student performance. This score is compared against grade-level benchmarks to determine risk levels."
      },
      {
        "heading": "Risk Indicators",
        "content": "Color-coded indicators help identify students' current performance levels:\n• Green (Low Risk): Student is meeting or exceeding grade-level expectations\n• Orange (Some Risk): Student is approaching benchmarks but may need monitoring\n• Red (High Risk): Student is significantly below benchmarks and requires intervention"
      },
      {
        "heading": "Readiness Levels",
        "content": "Readiness levels indicate whether students have the foundational skills needed for grade-level content. Use these indicators to plan differentiated instruction and intervention strategies."
      },
      {
        "heading": "Using This Data",
        "content": "Screening data should be used in conjunction with other assessments and classroom observations to make informed instructional decisions. Consider forming intervention groups based on similar needs and monitoring progress regularly."
      }
    ]
  }
}
